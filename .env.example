# IngatlanMonitor — konfigurációs minta
#
# Használat:
#   cp .env.example .env
# majd töltsd ki az értékeket. A .env NINCS verziókövetve, és soha ne is legyen:
# titkot (jelszó, API-kulcs, token) kizárólag ide írj, kódba vagy
# docker-compose.yml-be soha.
#
# A docker compose automatikusan beolvassa ezt a fájlt a projekt gyökeréből,
# a Python oldalon pedig az envfile.py tölti be.

# ── Adatok helye ──────────────────────────────────────────────────────────────
# A host oldali könyvtár, ahová a konténerek az adatbázist, képeket, naplókat és
# az OAuth-fájlokat teszik (client_secret.json, token.pickle, state.json).
INGATLAN_DATA=/eleresi/ut/az/ingatlan-data/konyvtarhoz

# ── MariaDB ───────────────────────────────────────────────────────────────────
DB_HOST=192.168.0.10
DB_PORT=3306
DB_USER=ingatlan
DB_PASSWORD=ide-a-jelszot
DB_NAME=ingatlan

# ── Ollama (helyben futó LLM) ─────────────────────────────────────────────────
OLLAMA_URL=http://192.168.0.10:11434
OLLAMA_MODEL=minimax-m3:cloud

# ── Telegram értesítés ────────────────────────────────────────────────────────
# Bot létrehozása: @BotFather → /newbot. A chat ID-t a @userinfobot adja meg.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ── Opcionális ────────────────────────────────────────────────────────────────
# DeepL fordítás a dashboardon (üresen hagyva a funkció egyszerűen kikapcsol).
DEEPL_API_KEY=

# Flask session-kulcs. Üresen hagyva indulásonként generálódik — ilyenkor a
# bejelentkezett munkamenetek újraindításkor elvesznek.
SECRET_KEY=
